{
  "seed": 42,
  "model": {
    "image_size": 224,
    "embed_dim": 384,
    "encoder_depth": 12,
    "predictor_depth": 6,
    "num_heads": 6
  },
  "data": {
    "manifest": "data/loso/feng/manifest.json",
    "min_dt": 0.1,
    "max_dt": 3.0,
    "min_mean": 8.0,
    "crop_scale": [
      0.3,
      1.0
    ],
    "split_mode": "leave-out"
  },
  "batch_size": 256,
  "workers": 8,
  "cpu_threads": 6,
  "amp": true,
  "lr": 0.0005,
  "warmup_steps": 1000,
  "steps": 6000,
  "weight_decay": 0.04,
  "final_weight_decay": 0.4,
  "selection": "model_recall@5",
  "patience": 100,
  "log_every": 50,
  "eval_every": 500,
  "save_every": 500,
  "val_pairs_per_episode": 29,
  "eval_batch_size": 128
}
