{
  "seed": 42,
  "model": {
    "image_size": 224,
    "embed_dim": 384,
    "encoder_depth": 12,
    "predictor_depth": 6,
    "num_heads": 6
  },
  "data": {
    "manifest": "data/ifl_aligned/manifest.json",
    "min_dt": 0.19,
    "max_dt": 0.21,
    "min_mean": 8.0,
    "crop_scale": [
      0.3,
      1.0
    ],
    "eval_dt": 0.2,
    "split_mode": "leave-out"
  },
  "batch_size": 256,
  "workers": 8,
  "cpu_threads": 6,
  "amp": true,
  "lr": 0.0001,
  "warmup_steps": 250,
  "steps": 6000,
  "weight_decay": 0.04,
  "final_weight_decay": 0.4,
  "selection": "model_recall@5",
  "patience": 6,
  "log_every": 100,
  "eval_every": 500,
  "save_every": 500,
  "val_pairs_per_episode": 32,
  "eval_batch_size": 128,
  "validation_manifest": "data/ifl_aligned/manifest.json"
}
