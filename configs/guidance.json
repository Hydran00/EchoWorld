{
  "seed": 0,
  "world_checkpoint": "runs/mocap_random/best.pt",
  "backbone": "target_encoder",
  "data": {
    "manifest": "data/ifl_trimmed/manifest.json"
  },
  "sequence": {
    "num_frames": 8,
    "exp_alpha": 0.4,
    "seq_prob": 0.5,
    "color_jitter": 0.2,
    "goal_offset_s": 0.0,
    "min_episode_s": 2.0,
    "max_outside_fan_mean": 20.0,
    "eval_stride": 10
  },
  "guidance": {
    "fusion": "geomlp",
    "drop_path": 0.2,
    "num_planes": 1,
    "num_heads": 4
  },
  "batch_size": 64,
  "workers": 8,
  "cpu_threads": 6,
  "amp": true,
  "lr": 0.0005,
  "min_lr": 1e-06,
  "warmup_steps": 1000,
  "steps": 10000,
  "weight_decay": 0.05,
  "layer_decay": 0.65,
  "clip_grad": 1.0,
  "pred_last": false,
  "zero_motion": false,
  "selection": "ensemble_mae",
  "patience": null,
  "log_every": 50,
  "eval_every": 500,
  "save_every": 500,
  "eval_batch_size": 32
}
